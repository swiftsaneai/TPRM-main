# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft Entra ID — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
AUTH_MICROSOFT_ENTRA_ID=
AUTH_MICROSOFT_ENTRA_SECRET=
AUTH_MICROSOFT_ENTRA_TENANT_ID=

# N8N backend base URL (server-side only — never use NEXT_PUBLIC_ for this)
N8N_BASE_URL=https://your-n8n-instance.example.com
